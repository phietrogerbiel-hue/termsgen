# Copie este arquivo para .env e preencha. O .env fica fora do Git.
# Linhas comentadas mostram o valor padrão usado quando a variável não existe.

# ---------- servidor ----------
# PORT=3000
# Fuso usado para o ano impresso nos termos (o relógio do servidor pode estar em UTC).
# FUSO_HORARIO=America/Sao_Paulo

# ---------- login (obrigatório: sem ele ninguém entra) ----------
LOGIN_USUARIO=
# Gere com: npm run login:senha  (a senha em si não fica gravada, só o hash)
LOGIN_SENHA_HASH=
# LOGIN_SESSAO_HORAS=8

# ---------- Clicksign (opcional: sem token, o sistema só gera o PDF) ----------
# Token da API: Clicksign > Configurações > API. Nunca vai para o navegador nem para o log.
CLICKSIGN_ACCESS_TOKEN=
# sandbox ou producao. Precisa combinar com a conta de onde o token veio.
# CLICKSIGN_AMBIENTE=sandbox
# Dias até o envelope expirar.
# CLICKSIGN_PRAZO_DIAS=30
# ID da pasta dos envelopes (obrigatório em produção). Descubra com: npm run clicksign:pastas
CLICKSIGN_PASTA_ID=
# E-mails que acompanham a assinatura, separados por vírgula (obrigatório em produção).
CLICKSIGN_OBSERVADORES=
# all_steps (avisa a cada etapa) ou on_finished (só ao final).
# CLICKSIGN_OBSERVADOR_QUANDO=all_steps
# O observador recebe o PDF assinado?
# CLICKSIGN_OBSERVADOR_RECEBE_DOCUMENTO=true

# ---------- painel de termos enviados ----------
# Intervalo mínimo, em minutos, entre conferências automáticas no Clicksign.
# PAINEL_INTERVALO_MINUTOS=10
# Arquivo do banco SQLite (guarda nomes e e-mails: fica fora do Git e entra no backup).
# BANCO_ARQUIVO=dados/termsgen.db
